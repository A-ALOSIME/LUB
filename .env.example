# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical app origin; also allow APP_URL/auth/callback in Supabase Auth URLs.
APP_URL=http://127.0.0.1:3000
# Server-only PostgreSQL session-pooler URL from Supabase Connect.
DATABASE_URL=
# Two DIFFERENT 32-byte base64 keys. Generate each separately with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
IDENTIFIER_ENCRYPTION_KEY=
IDENTIFIER_LOOKUP_KEY=
# Optional public-knowledge service. Keep its token server-side.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
